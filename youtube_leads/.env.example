# YouTube Data API v3 (required)
YOUTUBE_API_KEY=

# Optional email enrichment providers
HUNTER_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=

# Optional Notion integration
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Storage location (defaults to ./data/leads.db)
LEADS_DB_PATH=

# HTTP behavior
USER_AGENT=YouTubeLeadsBot/0.1 (+contact@example.com)
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=4

# Logging
LOG_LEVEL=INFO
