# Copy to .env and load it however you prefer (`node --env-file=.env server/server.js` on Node 20+).

# Simulate every publish instead of calling the real APIs. Leave this on until
# the developer apps below are approved. Set to 0 to publish for real.
STUDIO_DRY_RUN=1

# Encrypts stored OAuth tokens at rest. Generate once, then never rotate it
# without reconnecting every account: `openssl rand -hex 32`
STUDIO_SECRET=

# The origin the platforms redirect back to, and the origin Meta pulls media
# from. Must be public and HTTPS for real publishing — a tunnel works in dev.
STUDIO_PUBLIC_URL=http://localhost:4400

# Where creators, accounts, posts and uploaded media live.
STUDIO_DATA=./.studio-data

# Which platforms this install offers. Default is tiktok,instagram,x.
# The Facebook and YouTube adapters are written and working — add them here to
# turn them back on: STUDIO_PLATFORMS=tiktok,instagram,x,facebook,youtube
STUDIO_PLATFORMS=tiktok,instagram,x

# --- Meta (Instagram; the same app also covers Facebook if you re-enable it) -
# developers.facebook.com -> create app -> add Instagram + Facebook Login
META_APP_ID=
META_APP_SECRET=

# --- TikTok ----------------------------------------------------------------
# developers.tiktok.com -> add the Content Posting API product
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- X ---------------------------------------------------------------------
# developer.x.com -> project -> app with OAuth 2.0 + PKCE, read & write.
# Note this is the only platform here with a paid API tier.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- YouTube (only needed if you re-enable it in STUDIO_PLATFORMS) ----------
# console.cloud.google.com -> enable YouTube Data API v3 -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
